CATIRA_ENV=development
CATIRA_JWT_SECRET=
PORT=3001

USER_MELI_CLIENT_ID=your-client-id-here
USER_MELI_CLIENT_SECRET=your-client-secret-here
USER_MELI_REDIRECT_URI=https://SEU-DOMINIO/admin

# Appmax Merchant. Vazio ou production = produção. sandbox = Sandbox.
# Preferir preencher no admin master (aba Appmax). Nunca commite o .env.
USER_APPMAX_CLIENT_ID=
USER_APPMAX_CLIENT_SECRET=
USER_APPMAX_ENV=production
USER_APPMAX_EXTERNAL_ID=
# Token longo e imprevisível. A URL no painel Appmax deve ser:
# https://SEU-DOMINIO-HTTPS/api/appmax/webhooks/<USER_APPMAX_WEBHOOK_TOKEN>
USER_APPMAX_WEBHOOK_TOKEN=

CATIRA_SQLITE_PATH=
CATIRA_BACKUP_DIR=
CATIRA_JSON_PATH=
